    "fetch_himalayas": {"main": [[{"node": "normalize_himalayas", "type": "main", "index": 0}]]},
    "fetch_jobicy": {"main": [[{"node": "normalize_jobicy", "type": "main", "index": 0}]]},
    "fetch_themuse": {"main": [[{"node": "normalize_themuse", "type": "main", "index": 0}]]},
    "normalize_remotive": {"main": [[{"node": "merge_all", "type": "main", "index": 0}]]},
    "normalize_remoteok": {"main": [[{"node": "merge_all", "type": "main", "index": 1}]]},
    "normalize_arbeitnow": {"main": [[{"node": "merge_all", "type": "main", "index": 2}]]},
    "normalize_himalayas": {"main": [[{"node": "merge_all", "type": "main", "index": 3}]]},
    "normalize_jobicy": {"main": [[{"node": "merge_all", "type": "main", "index": 4}]]},
    "normalize_themuse": {"main": [[{"node": "merge_all", "type": "main", "index": 5}]]},
    "merge_all": {"main": [[{"node": "filter_cloud_devops", "type": "main", "index": 0}]]},
    "filter_cloud_devops": {"main": [[{"node": "datatable_get_seen", "type": "main", "index": 0}]]},
    "datatable_get_seen": {"main": [[{"node": "dedup", "type": "main", "index": 0}]]},
    "filter_cloud_devops": {"main": [[{"node": "dedup", "type": "main", "index": 1}]]},
    "dedup": {"main": [[{"node": "discord_send", "type": "main", "index": 0}, {"node": "gmail_digest", "type": "main", "index": 0}]]},
