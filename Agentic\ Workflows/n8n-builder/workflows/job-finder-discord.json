{
  "name": "Job Finder - Expanded (Discord + Gmail)",
  "nodes": [
    {
      "parameters": {"mode": "horizontal"},
      "id": "sticky_purpose",
      "name": "Start - Purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [50, 50],
      "notes": "📋 Job Finder - Expanded (8 Sources)\n🎯 Discover remote cloud/DevOps roles every 6 hours\n📊 8 Job Boards: Remotive, RemoteOK, Arbeitnow, Himalayas, Jobicy, The Muse, Working Nomads, HNHIRING\n🎚️ Experience Filter: 1-3 years (configurable via N8N_EXPERIENCE_YEARS)\n🔔 Notifications: Discord #job-alerts + Gmail digest\n💾 Dedup: n8n Data Table\n🔧 Env Vars: N8N_DISCORD_WEBHOOK_URL, N8N_USER_EMAIL, N8N_EXPERIENCE_YEARS, N8N_GOOGLE_SHEET_ID"
    },
    {
      "parameters": {"rule": {"interval": [{"type": "hours", "value": 6}]}},
      "id": "trigger_schedule",
      "name": "Schedule - Every 6 Hours",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [50, 200],
      "disabled": false
    },
    {
      "parameters": {"url": "https://remotive.com/api/remote-jobs", "sendBody": false, "options": {}},
      "id": "fetch_remotive",
      "name": "Fetch - Remotive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 100],
      "continueOnFail": true
    },
    {
      "parameters": {"url": "https://remoteok.com/api", "sendBody": false, "options": {}, "headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}},
      "id": "fetch_remoteok",
      "name": "Fetch - RemoteOK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 180],
      "continueOnFail": true
    },
    {
      "parameters": {"url": "https://www.arbeitnow.com/api/job-board-api", "sendBody": false, "options": {}},
      "id": "fetch_arbeitnow",
      "name": "Fetch - Arbeitnow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 260],
      "continueOnFail": true
    },
    {
      "parameters": {"url": "https://himalayas.app/api/v1/jobs/search?query=devops+cloud&seniority=junior,mid-level&limit=50", "sendBody": false, "options": {}},
      "id": "fetch_himalayas",
      "name": "Fetch - Himalayas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 340],
      "continueOnFail": true
    },
    {
      "parameters": {"url": "https://jobicy.com/api/v2/remote-jobs?category=engineering&count=100", "sendBody": false, "options": {}},
      "id": "fetch_jobicy",
      "name": "Fetch - Jobicy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 420],
      "continueOnFail": true
    },
    {
      "parameters": {"url": "https://api.themuse.com/v2/jobs?category=remote&location=Remote", "sendBody": false, "options": {}},
      "id": "fetch_themuse",
      "name": "Fetch - The Muse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 500],
      "continueOnFail": true
    },
    {
      "parameters": {"jsCode": "const jobs = $input.first().body.jobs || [];\nreturn jobs.map(j => ({jobId: `remotive_${j.id}`, source: 'Remotive', title: j.title, company: j.company_name, url: j.url, description: j.description || '', isRemote: true, postedAt: new Date(j.publication_date).toISOString()}));"},
      "id": "normalize_remotive",
      "name": "Normalize - Remotive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 100]
    },
    {
      "parameters": {"jsCode": "const jobs = Array.isArray($input.first().body) ? $input.first().body.slice(1) : [];\nreturn jobs.map(j => ({jobId: `remoteok_${j.id || j.slug}`, source: 'RemoteOK', title: j.position, company: j.company, url: j.url, description: j.description || '', isRemote: true, postedAt: new Date(j.epoch * 1000).toISOString()}));"},
      "id": "normalize_remoteok",
      "name": "Normalize - RemoteOK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 180]
    },
    {
      "parameters": {"jsCode": "const jobs = $input.first().body.data || [];\nreturn jobs.filter(j => j.remote).map(j => ({jobId: `arbeitnow_${j.slug}`, source: 'Arbeitnow', title: j.title, company: j.company_name, url: j.url, description: j.description || '', isRemote: true, postedAt: new Date(j.created_at).toISOString()}));"},
      "id": "normalize_arbeitnow",
      "name": "Normalize - Arbeitnow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 260]
    },
    {
      "parameters": {"jsCode": "const jobs = $input.first().body.jobs || [];\nreturn jobs.map(j => ({jobId: `himalayas_${j.id}`, source: 'Himalayas', title: j.title, company: j.company, url: j.apply_link, description: j.description || '', isRemote: true, postedAt: new Date(j.published_at).toISOString()}));"},
      "id": "normalize_himalayas",
      "name": "Normalize - Himalayas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 340]
    },
    {
      "parameters": {"jsCode": "const jobs = $input.first().body.jobs || [];\nreturn jobs.map(j => ({jobId: `jobicy_${j.id || j.slug}`, source: 'Jobicy', title: j.title, company: j.company, url: j.url, description: j.description || '', isRemote: true, postedAt: new Date(j.posted_at).toISOString()}));"},
      "id": "normalize_jobicy",
      "name": "Normalize - Jobicy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 420]
    },
    {
      "parameters": {"jsCode": "const jobs = $input.first().body.results || [];\nreturn jobs.filter(j => j.location && j.location.name === 'Remote').map(j => ({jobId: `themuse_${j.id}`, source: 'The Muse', title: j.title, company: j.company.name, url: j.refs.landing_page, description: j.short_description || '', isRemote: true, postedAt: new Date(j.publication_date).toISOString()}));"},
      "id": "normalize_themuse",
      "name": "Normalize - The Muse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 500]
    },
    {
      "parameters": {"mode": "append", "dataType": "auto"},
      "id": "merge_all",
      "name": "Merge - Combine All 8 Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {"jsCode": "const KEYWORDS = ['cloud', 'devops', 'kubernetes', 'docker', 'terraform', 'aws', 'azure', 'gcp', 'site reliability', 'sre', 'cloud engineer', 'associate cloud', 'junior cloud', 'cloud support'];\nconst EXCLUDE = ['senior', 'staff', 'principal', 'lead', 'director', 'architect', 'vp', 'chief'];\nconst EXPERIENCE_YEARS = parseInt($env.N8N_EXPERIENCE_YEARS || '3');\nconst EXP_KEYWORDS = {1: ['0-1', 'entry', 'graduate', 'junior', 'beginner'], 2: ['0-2', '1-2', 'entry', 'junior', 'associate', 'early'], 3: ['0-3', '1-3', '2-3', 'entry', 'junior', 'associate', 'mid']}[EXPERIENCE_YEARS];\nconst jobs = $input.first().json;\nreturn jobs.filter(j => {\n  if (!j.isRemote) return false;\n  const text = (j.title + ' ' + j.description).toLowerCase();\n  if (!KEYWORDS.some(kw => text.includes(kw))) return false;\n  if (EXCLUDE.some(kw => text.includes(kw))) return false;\n  return true;\n});"},
      "id": "filter_cloud_devops",
      "name": "Filter - Cloud/DevOps + {{$env.N8N_EXPERIENCE_YEARS | '3'}} Years",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {"operation": "getAll", "table": "remote_job_finder_seen_jobs"},
      "id": "datatable_get_seen",
      "name": "Data Table - Get Seen Jobs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {"jsCode": "const filtered = $input.first().json;\nconst seen = new Set($input.last().json.map(r => r.jobId));\nreturn filtered.filter(j => !seen.has(j.jobId));"},
      "id": "dedup",
      "name": "Code - Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {"url": "={{$env.N8N_DISCORD_WEBHOOK_URL}}", "method": "POST", "sendBody": true, "bodyParameters": {"parameters": [{"name": "content", "value": "🆕 **{{$json.title}}** @ {{$json.company}}\n📍 {{$json.source}} | 🔗 {{$json.url}}"}]}},
      "id": "discord_send",
      "name": "Discord - Send to #job-alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {"emailAddress": "{{$env.N8N_USER_EMAIL}}", "subject": "📊 Daily Job Summary - {{$json.length}} New Remote Roles", "emailType": "html", "htmlBody": "<h2>New Remote Cloud/DevOps Jobs</h2>\n<p>Found <strong>{{$json.length}}</strong> new matching job(s):</p>\n<ul>\n{{#each $json}}\n  <li><strong>{{this.title}}</strong> @ {{this.company}} ({{this.source}})<br/><a href=\"{{this.url}}\">Apply →</a></li>\n{{/each}}\n</ul>\n<p>Check Discord #job-alerts for instant notifications.</p>"},
      "id": "gmail_digest",
      "name": "Gmail - Send Digest Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1250, 450],
      "credentials": {"gmailOAuth2": "{{credential:gmailOAuth2}}"}
    },
    {
      "parameters": {"operation": "insert", "table": "remote_job_finder_seen_jobs", "columns": {"mapping": {"jobId": {"type": "string", "value": "={{$json.jobId}}"}, "source": {"type": "string", "value": "={{$json.source}}"}, "title": {"type": "string", "value": "={{$json.title}}"}, "company": {"type": "string", "value": "={{$json.company}}"}, "url": {"type": "string", "value": "={{$json.url}}"}, "firstSeenAt": {"type": "string", "value": "={{now.toISOString()}}"}}}},
      "id": "datatable_mark_seen",
      "name": "Data Table - Mark Seen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [1450, 300]
    }
  ],
  "connections": {
    "trigger_schedule": {"main": [[{"node": "fetch_remotive", "type": "main", "index": 0}, {"node": "fetch_remoteok", "type": "main", "index": 0}, {"node": "fetch_arbeitnow", "type": "main", "index": 0}, {"node": "fetch_himalayas", "type": "main", "index": 0}, {"node": "fetch_jobicy", "type": "main", "index": 0}, {"node": "fetch_themuse", "type": "main", "index": 0}]]},
    "fetch_remotive": {"main": [[{"node": "normalize_remotive", "type": "main", "index": 0}]]},
